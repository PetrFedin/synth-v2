SYNTHA_V2_DATABASE_URL=postgresql://syntha:syntha_local@127.0.0.1:5434/syntha_v2
HOST=127.0.0.1
PORT=4100

SYNTHA_DB_POOL_MAX=10
SYNTHA_DB_CONNECT_TIMEOUT_MS=5000
SYNTHA_DB_IDLE_TIMEOUT_MS=30000
SYNTHA_DB_READY_ATTEMPTS=30
SYNTHA_DB_READY_DELAY_MS=1000

SYNTHA_NOTIFICATION_PROJECTION_INTERVAL_MS=1000
SYNTHA_NOTIFICATION_PROJECTION_BATCH_SIZE=100
# Optional stable instance id. Leave empty to generate a unique id at process start.
SYNTHA_NOTIFICATION_PROJECTION_WORKER_ID=
SYNTHA_NOTIFICATION_PROJECTION_LEASE_MS=30000
SYNTHA_NOTIFICATION_PROJECTION_RETRY_DELAY_MS=5000
SYNTHA_NOTIFICATION_PROJECTION_MAX_ATTEMPTS=5
SYNTHA_NOTIFICATION_PROJECTION_STALE_MS=5000
SYNTHA_NOTIFICATION_PROJECTION_FAILURE_THRESHOLD=3

# Leave URL and secret empty to disable external outbox delivery.
# Production endpoints must use HTTPS. The receiver should deduplicate by Idempotency-Key/event id.
SYNTHA_OUTBOX_WEBHOOK_URL=
SYNTHA_OUTBOX_WEBHOOK_SECRET=
SYNTHA_OUTBOX_WEBHOOK_TIMEOUT_MS=10000
SYNTHA_OUTBOX_ALLOW_INSECURE_LOCALHOST=false
SYNTHA_OUTBOX_PUBLICATION_INTERVAL_MS=1000
SYNTHA_OUTBOX_PUBLICATION_BATCH_SIZE=25
SYNTHA_OUTBOX_PUBLICATION_PARALLELISM=4
# Optional stable instance id. Leave empty to generate a unique id at process start.
SYNTHA_OUTBOX_PUBLICATION_WORKER_ID=
SYNTHA_OUTBOX_PUBLICATION_LEASE_MS=300000
SYNTHA_OUTBOX_PUBLICATION_RETRY_DELAY_MS=5000
SYNTHA_OUTBOX_PUBLICATION_MAX_RETRY_DELAY_MS=300000
SYNTHA_OUTBOX_PUBLICATION_MAX_ATTEMPTS=10
SYNTHA_OUTBOX_PUBLICATION_STALE_MS=5000
SYNTHA_OUTBOX_PUBLICATION_FAILURE_THRESHOLD=3

SYNTHA_MAINTENANCE_INTERVAL_MS=21600000
SYNTHA_MAINTENANCE_RETRY_DELAY_MS=300000
SYNTHA_COMMAND_RETENTION_MS=2592000000
SYNTHA_AUTH_AUDIT_RETENTION_MS=7776000000
SYNTHA_AUTH_THROTTLE_RETENTION_MS=604800000
SYNTHA_OUTBOX_RETENTION_MS=2592000000

# Protected Prometheus endpoint. Generate a unique token of at least 32 characters.
SYNTHA_METRICS_ENABLED=false
SYNTHA_METRICS_TOKEN=
SYNTHA_METRICS_CACHE_TTL_MS=5000

SYNTHA_HTTP_REQUEST_TIMEOUT_MS=30000
SYNTHA_HTTP_HEADERS_TIMEOUT_MS=15000
SYNTHA_HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
SYNTHA_HTTP_MAX_REQUESTS_PER_SOCKET=1000
SYNTHA_HTTP_MAX_HEADERS_COUNT=100
SYNTHA_SHUTDOWN_GRACE_MS=10000

SYNTHA_SESSION_TTL_MS=43200000
SYNTHA_AUTH_MAX_FAILURES=5
SYNTHA_AUTH_WINDOW_MS=900000
SYNTHA_AUTH_BLOCK_MS=900000
SYNTHA_REVOKED_SESSION_RETENTION_MS=604800000

SYNTHA_BOOTSTRAP_EMAIL=owner@syntha.local
SYNTHA_BOOTSTRAP_PASSWORD=replace-with-at-least-12-characters
SYNTHA_BOOTSTRAP_NAME=Syntha Owner
SYNTHA_BOOTSTRAP_ORGANISATION=Syntha Brand
SYNTHA_BOOTSTRAP_ORGANISATION_TYPE=brand

# Shared password for optional demo sales and buyer accounts created by npm run demo:seed.
SYNTHA_DEMO_PASSWORD=Syntha-demo-2027!
