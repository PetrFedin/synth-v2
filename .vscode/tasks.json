{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Syntha V2: install",
      "type": "shell",
      "command": "npm ci --ignore-scripts --no-audit --no-fund",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Syntha V2: database up",
      "type": "shell",
      "command": "docker compose up -d",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Syntha V2: migrate",
      "type": "shell",
      "command": "npm run db:migrate",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Syntha V2: verify",
      "type": "shell",
      "command": "npm run verify",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Syntha V2: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
