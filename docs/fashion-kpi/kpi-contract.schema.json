{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syntha.local/schemas/fashion-kpi-contract-v16.json",
  "title": "SYNTH-V2 Fashion KPI Contract v16",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "canonicalName",
    "lifecycleStatus",
    "formulaVersion",
    "businessDefinition",
    "businessFormula",
    "calculationPrimitive",
    "canonicalUom",
    "grain",
    "eligiblePopulation",
    "temporalClass",
    "aggregationRule",
    "zeroNullErrorPolicy",
    "directionality",
    "owner",
    "dataSteward",
    "releaseStatus"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "canonicalName": {"type": "string", "minLength": 1},
    "domain": {"type": "string"},
    "role": {"enum": ["CANONICAL", "SPLIT_CHILD", "BLOCKED_UMBRELLA", "ALIAS"]},
    "lifecycleStatus": {"type": "string"},
    "formulaVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "businessDefinition": {"type": "string", "minLength": 1},
    "businessPurpose": {"type": "string"},
    "businessFormula": {"type": "string", "minLength": 1},
    "enginePattern": {"type": "string"},
    "calculationPrimitive": {"type": "string", "minLength": 1},
    "numerator": {"type": ["string", "null"]},
    "denominator": {"type": ["string", "null"]},
    "normalizerK": {"type": ["number", "string", "null"]},
    "canonicalUom": {"type": "string", "minLength": 1},
    "numeratorUom": {"type": ["string", "null"]},
    "denominatorUom": {"type": ["string", "null"]},
    "dimensionFamily": {"type": "string"},
    "storageScale": {"type": "string"},
    "displayRule": {"type": "string"},
    "mathematicalRange": {"type": "string"},
    "signConvention": {"type": "string"},
    "directionality": {"type": "string", "minLength": 1},
    "goalFunction": {"type": "string"},
    "targetBandSemantics": {"type": ["string", "null"]},
    "grain": {"type": "string", "minLength": 1},
    "caseEventIdentity": {"type": ["string", "null"]},
    "eligiblePopulation": {"type": "string", "minLength": 1},
    "inclusionRule": {"type": ["string", "null"]},
    "exclusionRule": {"type": ["string", "null"]},
    "temporalClass": {"type": "string", "minLength": 1},
    "stockFlowClass": {"type": "string"},
    "eventTimeBasis": {"type": ["string", "null"]},
    "cohortAsOfMode": {"type": ["string", "null"]},
    "aggregationRule": {"type": "string", "minLength": 1},
    "additivity": {"type": "string"},
    "distinctnessKey": {"type": ["string", "null"]},
    "dueCensoringRule": {"type": ["string", "null"]},
    "quantileMethod": {"type": ["string", "null"]},
    "zeroNullErrorPolicy": {"type": "string", "minLength": 1},
    "uomConversionRule": {"type": ["string", "null"]},
    "currencyFxRule": {"type": ["string", "null"]},
    "logicalSourceEntity": {"type": ["string", "null"]},
    "logicalFieldContract": {"type": ["string", "null"]},
    "sourceContracts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "inputMappings": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "nativeSourceContractVersion": {"type": ["string", "null"]},
    "physicalSource": {
      "type": "object",
      "properties": {
        "system": {"type": ["string", "null"]},
        "schemaOrTopic": {"type": ["string", "null"]},
        "entity": {"type": ["string", "null"]},
        "fields": {"type": "array", "items": {"type": "string"}},
        "primaryOrEventKey": {"type": ["string", "null"]},
        "eventTimestamp": {"type": ["string", "null"]},
        "joinCardinality": {"type": ["string", "null"]},
        "mappingStatus": {"enum": ["PENDING", "MAPPED_UNVERIFIED", "VERIFIED", "DEPRECATED"]}
      },
      "required": ["mappingStatus"]
    },
    "semanticSqlPattern": {"type": ["string", "null"]},
    "daxPattern": {"type": ["string", "null"]},
    "measurementValidityRule": {"type": ["string", "null"]},
    "scaleContract": {"type": ["string", "null"]},
    "reconciliationControl": {"type": ["string", "null"]},
    "antiGamingControl": {"type": ["string", "null"]},
    "validationChecks": {"type": ["string", "null"]},
    "owner": {"type": "string", "minLength": 1},
    "dataSteward": {"type": "string", "minLength": 1},
    "refreshWindow": {"type": ["string", "null"]},
    "lateDataRestatement": {"type": ["string", "null"]},
    "thresholdVersion": {"type": ["string", "null"]},
    "semanticIdentityKey": {"type": "string"},
    "definitionAuthorityClass": {"type": ["string", "null"]},
    "authoritySourceId": {"type": ["string", "null"]},
    "releaseStatus": {"type": "string", "minLength": 1},
    "testBundle": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"role": {"const": "ALIAS"}}},
      "then": {"properties": {"releaseStatus": {"pattern": "ALIAS|CANONICAL|NONPUBLISH"}}}
    },
    {
      "if": {"properties": {"role": {"const": "BLOCKED_UMBRELLA"}}},
      "then": {"properties": {"releaseStatus": {"pattern": "BLOCK|DO_NOT_PUBLISH"}}}
    },
    {
      "if": {"properties": {"releaseStatus": {"const": "PRODUCTION_READY"}}},
      "then": {
        "required": ["physicalSource"],
        "properties": {
          "physicalSource": {
            "properties": {"mappingStatus": {"const": "VERIFIED"}}
          }
        }
      }
    }
  ]
}
